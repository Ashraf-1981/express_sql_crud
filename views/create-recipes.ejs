<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add Recipe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Add Recipe</h1>

        <form method="POST" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" name="title" class="form-control" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Instructions</label>
                <textarea name="instructions" class="form-control" rows="4" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Cuisine</label>
                <select name="cuisine_id" class="form-select" required>
                    <option value="">-- Select cuisine --</option>
                    <% cuisines.forEach(function(c) { %>
                        <option value="<%= c.cuisine_id %>"><%= c.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">User</label>
                <select name="user_id" class="form-select" required>
                    <option value="">-- Select user --</option>
                    <% users.forEach(function(u) { %>
                        <option value="<%= u.user_id %>"><%= u.email %></option>
                    <% }); %>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Create Recipe</button>
            <a href="/recipes" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>
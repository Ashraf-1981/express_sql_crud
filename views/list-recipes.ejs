<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Recipes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h1>Recipes</h1>
        <a href="/recipes/create" class="btn btn-primary mb-3">Add Recipe</a>

        <ul class="list-group">
            <% recipes.forEach(function(r) { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= r.recipes.title %></strong><br>
                        <small class="text-muted">
                            Cuisine: <%= r.cuisines.name %> |
                            By: <%= r.users.email %>
                        </small>
                    </div>
                    <div>
                        <a href="/recipes/<%= r.recipes.recipe_id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                        <a href="/confirm_delete_recipe/<%= r.recipes.recipe_id %>" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </li>
            <% }); %>
        </ul>
    </div>
</body>
</html>